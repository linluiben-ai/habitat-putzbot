# Vorlage für die lokale .env — kopieren nach `.env` und ausfüllen.
#   cp .env.example .env
#
# .env ist in .gitignore und wird von config.py automatisch geladen.
# Echte Umgebungsvariablen haben Vorrang, die GitHub-Action-Secrets bleiben
# davon also unberührt.
#
# ⚠️ Tokens gehören NUR hierhin (bzw. in die GitHub-Secrets) — nicht in einen
#    Chat, nicht in einen Commit.

# ---------------------------------------------------------------- Pflicht
# Notion-Integration-Token ("ntn_..." bzw. "secret_...")
NOTION_TOKEN=
# Slack BOT User OAuth Token des produktiven Workspace ("xoxb-...").
# NICHT das App-Level-Token ("xapp-...") — das wird hier nirgends gebraucht.
SLACK_TOKEN=

# Notion-DATA-SOURCE-IDs (nicht die Datenbank-/Seiten-ID!)
DS_A_ID=32b442c0-9a5c-4666-9f78-6647909752b8
DS_B_ID=2eab71ac-7d09-8055-9bf6-000bb4351efb

# Slack-Kanal für Erinnerungen und Zyklus-Übersicht.
# Sandbox: die ID des Testkanals. Produktiv: #räumen-und-ratschen.
SLACK_CHANNEL_ID=

# Notion-Template für neue Wochenseiten ("Neue Putzcrew (Automation)")
TEMPLATE_ID=2eab71ac-7d09-80ef-954f-d3e298915dfe

# ------------------------------------------------ Sandbox-Slack (optional)
# Schaltet Token, Kanal und DM-Umleitung auf den Sandbox-Workspace um, ohne
# dass die produktiven Werte oben angefasst werden müssen.
# SANDBOX_SLACK_TOKEN und SANDBOX_SLACK_CHANNEL_ID sind dann PFLICHT — sonst
# bricht der Bot ab, statt versehentlich im echten Workspace zu posten.
SANDBOX=false
# Bot User OAuth Token der Sandbox-App ("xoxb-...")
SANDBOX_SLACK_TOKEN=
# Testkanal im Sandbox-Workspace
SANDBOX_SLACK_CHANNEL_ID=
# Deine User-ID IM SANDBOX-WORKSPACE (eine andere als im echten!).
# Wenn gesetzt, gehen alle DMs an dich statt an die Mitglieder — im Sandbox
# nötig, weil dort niemand die @das-habitat.de-Adressen aus Notion hat.
SANDBOX_SLACK_TEST_USER_ID=

# ---------------------------------------------------- Notion-Testkopie
# Alle DMs umleiten, auch ohne SANDBOX (im echten Workspace: U07UDK6V29F).
SLACK_TEST_USER_ID=

# Auf die Notion-Testkopie umschalten.
# TEST_DS_B_ID und TEST_TEMPLATE_ID sind dann PFLICHT — sonst bricht der Bot
# ab, statt still auf die Produktivdaten zurückzufallen.
USE_TEST_DATA=false
# "❌ Putzplan (NUR FÜR TESTS)"
TEST_DS_B_ID=565b71ac-7d09-82ec-8ce8-870a78528167
# Template der Kopie — muss zu dem passen, das oben in TEMPLATE_ID steht:
#   "Neue Putzcrew (Automation)" -> 0a5b71ac-7d09-83ee-8af0-01b245383ca7
#   "Putzcrew KW " (Default)     -> 4a1b71ac-7d09-82a1-adef-811911765385
TEST_TEMPLATE_ID=0a5b71ac-7d09-83ee-8af0-01b245383ca7
# Optional und am besten LEER LASSEN: die Mitgliederliste wird nur gelesen,
# die echte reicht zum Testen völlig.
# ⚠️ Die alte Kopie "Mitgliederliste (Testdatenbank, inoffiziell!)" funktioniert
#    NICHT — ihr fehlen Putzstatus, Putzplan und Interne Email, die Notion-Query
#    scheitert dann mit "Putzstatus is not a property that exists".
TEST_DS_A_ID=

# Name der Putzplan-Relation auf der Mitgliederliste.
# Produktiv "Putzplan"; bei USE_TEST_DATA=true schaltet der Bot automatisch auf
# TEST_PUTZPLAN_RELATION_PROP um — hier ist also nichts von Hand umzustellen.
PUTZPLAN_RELATION_PROP=Putzplan
TEST_PUTZPLAN_RELATION_PROP=Putztest

# ------------------------------------------------------------ Betriebsmodi
# Kompletter Ablauf, aber keine Schreibzugriffe auf Notion/Slack.
DRY_RUN=false
# Kanal-Nachrichten unterdrücken, DMs weiter zulassen. Für Testläufe gegen den
# ECHTEN Workspace gedacht — zusammen mit SLACK_TEST_USER_ID bekommt dann
# ausschließlich die Testperson etwas zu sehen.
DM_ONLY=false
# Ausführliche Diagnose (Poolgrößen je Fallback-Stufe, übersprungene Seiten).
DEBUG=false
# Zyklusplanung erzwingen, auch wenn gerade nicht Zyklusende ist.
# Ohne das passiert bei einem Testlauf mitten im Zyklus fast nichts.
FORCE_PLAN=false