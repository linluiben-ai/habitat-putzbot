# Vorlage für die lokale .env — kopieren nach `.env` und ausfüllen.
#   cp .env.example .env
#
# .env ist in .gitignore und wird von config.py automatisch geladen.
# Echte Umgebungsvariablen haben Vorrang, die GitHub-Action-Secrets bleiben
# davon also unberührt.
#
# ⚠️ Tokens gehören NUR hierhin (bzw. in die GitHub-Secrets) — nicht in einen
#    Chat, nicht in einen Commit.

# ---------------------------------------------------------------- Pflicht
# Notion-Integration-Token ("ntn_..." bzw. "secret_...")
NOTION_TOKEN=
# Slack Bot User OAuth Token ("xoxb-...")
# Für Sandbox-Tests der Token der Sandbox-App, nicht der produktive!
SLACK_TOKEN=

# Notion-DATA-SOURCE-IDs (nicht die Datenbank-/Seiten-ID!)
DS_A_ID=32b442c0-9a5c-4666-9f78-6647909752b8
DS_B_ID=2eab71ac-7d09-8055-9bf6-000bb4351efb

# Slack-Kanal für Erinnerungen und Zyklus-Übersicht.
# Sandbox: die ID des Testkanals. Produktiv: #räumen-und-ratschen.
SLACK_CHANNEL_ID=

# Notion-Template für neue Wochenseiten ("Neue Putzcrew (Automation)")
TEMPLATE_ID=2eab71ac-7d09-80ef-954f-d3e298915dfe

# ---------------------------------------------------- Testen (optional)
# Alle DMs an diese eine Slack-User-ID umleiten, statt an die Mitglieder.
# Im Sandbox-Workspace hast du eine andere ID als im echten (dort U07UDK6V29F).
SLACK_TEST_USER_ID=

# Auf die Notion-Testkopie umschalten.
# TEST_DS_B_ID und TEST_TEMPLATE_ID sind dann PFLICHT — sonst bricht der Bot
# ab, statt still auf die Produktivdaten zurückzufallen.
USE_TEST_DATA=false
TEST_DS_B_ID=
TEST_TEMPLATE_ID=
# Optional: die Mitgliederliste wird nur gelesen, die echte reicht zum Testen.
TEST_DS_A_ID=

# Name der Putzplan-Relation auf der Mitgliederliste.
# Die duplizierte Putzplan-DB legt dort eine zweite Property an — hier deren
# exakten Namen eintragen, sonst liest der Bot beim Testen die echte Historie.
PUTZPLAN_RELATION_PROP=Putzplan

# ------------------------------------------------------------ Betriebsmodi
# Kompletter Ablauf, aber keine Schreibzugriffe auf Notion/Slack.
DRY_RUN=false
# Ausführliche Diagnose (Poolgrößen je Fallback-Stufe, übersprungene Seiten).
DEBUG=false
# Zyklusplanung erzwingen, auch wenn gerade nicht Zyklusende ist.
# Ohne das passiert bei einem Testlauf mitten im Zyklus fast nichts.
FORCE_PLAN=false
